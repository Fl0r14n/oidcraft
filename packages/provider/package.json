{
  "name": "@oidcraft/provider",
  "version": "0.3.0",
  "description": "An OpenID Provider library: RFC-compliant core, runtime-portable, pluggable storage, identity brokering built in",
  "license": "MIT",
  "author": "Fl0r14n <florian.chis@gmail.com>",
  "homepage": "https://github.com/Fl0r14n/oidcraft/tree/main/packages/provider",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fl0r14n/oidcraft",
    "directory": "packages/provider"
  },
  "keywords": [
    "oidc",
    "openid",
    "openid-connect",
    "oauth",
    "oauth2",
    "oauth2.1",
    "authorization-server",
    "identity-provider",
    "sso",
    "identity-broker",
    "pkce",
    "dpop",
    "bun",
    "deno"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./broker": {
      "types": "./dist/broker.d.mts",
      "import": "./dist/broker.mjs"
    },
    "./accounts": {
      "types": "./dist/accounts.d.mts",
      "import": "./dist/accounts.mjs"
    },
    "./interaction": {
      "types": "./dist/interaction.d.mts",
      "import": "./dist/interaction.mjs"
    },
    "./runtimes/node": {
      "types": "./dist/runtimes/node.d.mts",
      "import": "./dist/runtimes/node.mjs"
    },
    "./runtimes/bun": {
      "types": "./dist/runtimes/bun.d.mts",
      "import": "./dist/runtimes/bun.mjs"
    },
    "./runtimes/deno": {
      "types": "./dist/runtimes/deno.d.mts",
      "import": "./dist/runtimes/deno.mjs"
    },
    "./runtimes/workerd": {
      "types": "./dist/runtimes/workerd.d.mts",
      "import": "./dist/runtimes/workerd.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && bun run verify:entries",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "bun check",
    "verify:entries": "bun run verify-entries.ts"
  },
  "dependencies": {
    "@oidcraft/adapter": "workspace:^",
    "@oidcraft/core": "workspace:^",
    "jose": "^6.2.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.7"
  }
}
