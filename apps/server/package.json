{
  "name": "@oidcraft/server-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env index.ts",
    "build": "vue-tsgo --noEmit",
    "jwks": "bun ./scripts/generate-jwks.ts",
    "typecheck": "vue-tsgo --noEmit"
