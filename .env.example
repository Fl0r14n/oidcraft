# Server-only (Bun.env). Never prefixed OIDCRAFT_PUBLIC_ — those reach the browser.
OIDCRAFT_ISSUER=http://localhost:3001
SERVER_PORT=3001
# Optional PEM files, for an https issuer (Discovery 1.0 §3); see conformance/README.md.
# SERVER_TLS_CERT=
# SERVER_TLS_KEY=
# Conformance runs only: the suite's base URL seeds its two clients (conformance/README.md).
# OIDCRAFT_CONFORMANCE_SUITE=https://localhost.emobix.co.uk:8443
# The client is `bun index.html` — Bun's own dev server reads BUN_PORT.
BUN_PORT=3000
DATABASE_URL=postgres://oidcraft:oidcraft@localhost:5432/oidcraft

# Required in production: the signing keys. `bun run --filter=@oidcraft/demo-server jwks` generates a set.
OIDCRAFT_JWKS=

# Upstream providers for brokering (FR-F1). Empty means local accounts only. Each upstream must
# whitelist the callback, ${OIDCRAFT_ISSUER}/federation/callback — http://localhost:3001/federation/callback here.
UPSTREAM_GOOGLE_CLIENT_ID=
UPSTREAM_GOOGLE_CLIENT_SECRET=
UPSTREAM_ENTRA_CLIENT_ID=
UPSTREAM_ENTRA_CLIENT_SECRET=

# Inlined into the client bundle — public by construction.
OIDCRAFT_PUBLIC_ISSUER=http://localhost:3001
OIDCRAFT_PUBLIC_CLIENT_ID=demo-client
OIDCRAFT_PUBLIC_SCOPE=openid profile email offline_access
OIDCRAFT_PUBLIC_ORIGIN=http://localhost:3000

# Where the demo stores its state: a SQLite file, or `memory` to keep nothing across restarts.
OIDCRAFT_DB=data/oidcraft.sqlite

# Seals TOTP secrets at rest: 32 random bytes, base64url. Required in production; without it, development
# generates one per process and enrolled authenticators stop working at restart.
#   bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
OIDCRAFT_TOTP_KEY=

# The demo accounts admin, ada and grace share this password.
OIDCRAFT_DEMO_PASSWORD=correct horse battery staple

# Self-service sign-up on the login screen. `off` hides it.
OIDCRAFT_SIGNUP=on

# Account ids allowed into /admin, comma-separated. Empty lets nobody in. An allowlist is the demo's
# answer; who is an administrator is the host's decision, never the library's (FR-M1).
OIDCRAFT_ADMINS=ada

# Realms (FR-M4): `on` serves one issuer per realm at http://<realm>.localhost:3001, created from the
# admin, with this issuer as the control plane the operator signs in through. Off, it is one issuer.
OIDCRAFT_REALMS=off

# FAPI 2.0 (FR-C21). With an https issuer the demo always seeds `fapi-demo`, a FAPI client beside the
# public ones; open /fapi-demo to run it. `fapi2` here puts every client under the profile, which is
# what its conformance plan wants — and refuses the public admin and account apps.
# OIDCRAFT_PROFILE=fapi2

# Seconds a sign-in session lives. Only the FAPI conformance run sets it, so every module starts signed
# out (conformance/README.md). Unset, it is the library's default.
# OIDCRAFT_SESSION_TTL=

# The screens' brand. The accent is any CSS colour.
OIDCRAFT_BRAND_NAME=oidcraft
OIDCRAFT_BRAND_ACCENT=
