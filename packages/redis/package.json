{
  "name": "@oidcraft/redis",
  "version": "0.3.0",
  "description": "A Redis storage adapter for @oidcraft/provider, through one command function the host supplies \u2014 any client, any runtime.",
  "license": "MIT",
  "author": "Fl0r14n <florian.chis@gmail.com>",
  "homepage": "https://github.com/Fl0r14n/oidcraft/tree/main/packages/redis",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fl0r14n/oidcraft",
    "directory": "packages/redis"
  },
  "keywords": [
    "oidc",
    "openid",
    "oauth2",
    "authorization-server",
    "oidcraft",
    "storage",
    "adapter",
    "redis"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && bun run verify:entries",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "bun check",
    "verify:entries": "bun run verify-entries.ts"
  },
  "peerDependencies": {
    "@oidcraft/adapter": "workspace:^"
  },
  "devDependencies": {
    "@oidcraft/adapter": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.7"
  }
}
