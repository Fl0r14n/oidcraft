    "drizzle-orm": "1.0.0-rc.5",
    "jose": "^6.2.17",
    "@oidcraft/provider": "workspace:*",
    "pg": "^8.23.1",
    "uqr": "^0.1.3",
    "vue": "^3.5.45",
    "@oidcraft/vue": "workspace:*",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "bun-plugin-vue3": "^1.1.0",
    "tailwindcss": "^4.3.5",
    "vue-tsgo": "^0.3.0"
  }
