{
  "name": "@oidcraft/core",
  "version": "0.1.0",
  "description": "The OpenID Connect protocol shared by every oidcraft package: discovery, PKCE, the authorization round trip and ID token verification. No state, no storage, no framework.",
  "license": "MIT",
  "author": "Fl0r14n <florian.chis@gmail.com>",
  "homepage": "https://github.com/Fl0r14n/oidcraft/tree/main/packages/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fl0r14n/oidcraft",
    "directory": "packages/core"
  },
  "keywords": [
    "oidc",
    "openid",
    "openid-connect",
    "oauth",
    "oauth2",
    "oauth2.1",
    "pkce",
    "relying-party"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "bun check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "jose": "^6.2.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
