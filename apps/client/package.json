{
  "name": "@oidcraft/client-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env index.ts",
    "build": "vue-tsgo --noEmit && bun --env-file=../../.env build.ts",
    "typecheck": "vue-tsgo --noEmit"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-oidc": "^5.3.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "bun-plugin-vue3": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "vue-tsgo": "^0.3.0"
  }
}
