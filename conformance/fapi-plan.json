  "resource": {
    "resourceUrl": "https://localhost:3001/userinfo"
  },
  "browser": [
    {
      "match": "https://localhost:3001/authorize*",
      "tasks": [
        {
          "task": "Sign in, or pick the signed-in account",
          "optional": true,
          "match": "https://localhost:3001/interaction/*",
          "commands": [
            ["text", "id", "u", "conformance-user", "optional"],
            ["text", "id", "p", "conformance-password", "optional"],
            ["click", "css", "button[type=submit]"]
          ]
        },
        {
          "task": "Consent",
          "optional": true,
          "match": "https://localhost:3001/interaction/*",
          "commands": [["click", "css", "button[value=allow]"]]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [["wait", "id", "submission_complete", 10]]
        }
      ]
    }
  ],
  "override": {
    "fapi2-security-profile-final-user-rejects-authentication": {
      "browser": [
        {
          "match": "https://localhost:3001/authorize*",
          "tasks": [
            {
              "task": "Cancel the sign-in",
              "match": "https://localhost:3001/interaction/*",
              "commands": [["click", "css", "button[value=cancel]"]]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [["wait", "id", "submission_complete", 10]]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-ensure-unsigned-authorization-request-without-using-par-fails": {
      "browser": [
        {
          "match": "https://localhost:3001/authorize*",
          "tasks": [
            {
              "task": "Expect the error page",
              "match": "https://localhost:3001/authorize*",
              "commands": [["wait", "xpath", "//*", 10, "cannot continue", "update-image-placeholder"]]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-par-attempt-to-use-expired-request_uri": {
      "browser": [
        {
          "match": "https://localhost:3001/authorize*",
          "tasks": [
            {
              "task": "Expect the error page",
              "match": "https://localhost:3001/authorize*",
              "commands": [["wait", "xpath", "//*", 10, "cannot continue", "update-image-placeholder"]]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-par-attempt-reuse-request_uri": {
      "browser": [
        {
          "match": "https://localhost:3001/authorize*",
          "tasks": [
            {
              "task": "Sign in, or pick the signed-in account",
              "optional": true,
              "match": "https://localhost:3001/interaction/*",
              "commands": [
                ["text", "id", "u", "conformance-user", "optional"],
                ["text", "id", "p", "conformance-password", "optional"],
                ["click", "css", "button[type=submit]"]
              ]
            },
            {
              "task": "Consent",
              "optional": true,
              "match": "https://localhost:3001/interaction/*",
              "commands": [["click", "css", "button[value=allow]"]]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [["wait", "id", "submission_complete", 10]]
            }
          ],
          "match-limit": 1
        },
        {
          "match": "https://localhost:3001/authorize*",
          "tasks": [
            {
              "task": "Expect the error page",
              "match": "https://localhost:3001/authorize*",
              "commands": [["wait", "xpath", "//*", 10, "cannot continue", "update-image-placeholder"]]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-par-ensure-reused-request-uri-prior-to-auth-completion-succeeds": {
      "browser": [
        {
          "match": "https://localhost:3001/authorize*",
          "tasks": [
            {
              "task": "See the sign-in page, without signing in",
              "match": "https://localhost:3001/interaction/*",
              "commands": [["wait", "xpath", "//*", 10, "Sign in"]]
            }
          ],
          "match-limit": 1
        },
        {
          "match": "https://localhost:3001/authorize*",
          "tasks": [
            {
              "task": "Expect the error page",
              "match": "https://localhost:3001/authorize*",
              "commands": [["wait", "xpath", "//*", 10, "cannot continue", "update-image-placeholder"]]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-par-attempt-to-use-request_uri-for-different-client": {
      "browser": [
        {
          "match": "https://localhost:3001/authorize*",
          "tasks": [
            {
              "task": "Expect the error page",
              "match": "https://localhost:3001/authorize*",
              "commands": [["wait", "xpath", "//*", 10, "cannot continue", "update-image-placeholder"]]
            }
          ]
        }
      ]
    }
