{
  "name": "react-oauth-oidc",
  "version": "2.0.0",
  "author": "Fl0r14n <florian.chis@gmail.com>",
  "homepage": "https://github.com/Fl0r14n/oidcraft/tree/main/packages/react",
  "description": "A fully OAuth2.1 compliant react library",
  "license": "MIT",
  "keywords": [
    "react",
    "oauth",
    "oauth2",
    "oidc",
    "pkce",
    "authorization",
    "openid",
    "openid connect"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fl0r14n/oidcraft",
    "directory": "packages/react"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    },
    "./axios": {
      "types": "./dist/axios.d.mts",
      "import": "./dist/axios.mjs"
    },
    "./component": {
      "types": "./dist/component.d.mts",
      "import": "./dist/component.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && bun run verify:entries",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:entries": "bun run verify-entries.ts"
  },
  "peerDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/icons-material": ">=6",
    "@mui/material": ">=6",
    "axios": "^1",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@emotion/react": {
      "optional": true
    },
    "@emotion/styled": {
      "optional": true
    },
    "@mui/icons-material": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "axios": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@happy-dom/global-registrator": "latest",
    "@mui/icons-material": "latest",
    "@mui/material": "latest",
    "@oidcraft/client": "workspace:*",
    "@oidcraft/core": "workspace:*",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axios": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jose": "^6"
  }
}
