    "react-i18next": "latest",
    "react-oauth-oidc": "workspace:*",
    "react-router": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
