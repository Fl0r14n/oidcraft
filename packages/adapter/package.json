{
  "name": "@oidcraft/adapter",
  "version": "0.3.0",
  "description": "The storage contract of @oidcraft/provider: the Adapter stores and the records they hold, fromKv, key stores, an in-memory adapter and the shared conformance suite.",
  "license": "MIT",
  "author": "Fl0r14n <florian.chis@gmail.com>",
  "homepage": "https://github.com/Fl0r14n/oidcraft/tree/main/packages/adapter",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fl0r14n/oidcraft",
    "directory": "packages/adapter"
  },
  "keywords": [
    "oidc",
    "openid",
    "oauth2",
    "authorization-server",
    "oidcraft",
    "storage",
    "adapter"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./memory": {
      "types": "./dist/memory.d.mts",
      "import": "./dist/memory.mjs"
    },
    "./conformance": {
      "types": "./dist/conformance.d.mts",
      "import": "./dist/conformance.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && bun run verify:entries",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "bun check",
    "verify:entries": "bun run verify-entries.ts"
  },
  "dependencies": {
    "@oidcraft/core": "workspace:^",
    "jose": "^6.2.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.7"
  }
}
