    "drizzle-orm": "^0.45.4",
    "oidcraft": "workspace:*",
    "pg": "^8.23.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "bun-plugin-vue3": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "vue-tsgo": "^0.3.0"
  }
}
